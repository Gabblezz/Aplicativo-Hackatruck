        "type": "function",
        "z": "02b62f923772707e",
        "name": "Validar POST",
        "func": "const body = msg.payload || {};\n\nif (!body.tipo) {\n    msg.statusCode = 400;\n    msg.payload = { erro: \"O campo tipo e obrigatorio. Use usuario, postagem ou anuncio.\" };\n    return [null, msg];\n}\n\nconst tiposPermitidos = [\"usuario\", \"postagem\", \"anuncio\"];\nif (!tiposPermitidos.includes(body.tipo)) {\n    msg.statusCode = 400;\n    msg.payload = { erro: \"Tipo invalido. Use usuario, postagem ou anuncio.\" };\n    return [null, msg];\n}\n\nif (!body._id) {\n    body._id = body.tipo + \":\" + Date.now() + \":\" + Math.random().toString(36).slice(2, 8);\n}\n\nbody.createdAt = body.createdAt || new Date().toISOString();\nmsg._idEnviado = body._id;\nmsg.payload = body;\nreturn [msg, null];",

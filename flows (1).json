        "name": "Formatar resposta GET",
        "func": "msg.statusCode = 200;\n\nlet docs = [];\n\nif (Array.isArray(msg.payload)) {\n    docs = msg.payload;\n} else if (msg.payload && Array.isArray(msg.payload.documentos)) {\n    docs = msg.payload.documentos;\n} else if (msg.payload && Array.isArray(msg.payload.rows)) {\n    docs = msg.payload.rows.map(r => r.doc || r.value || r);\n} else if (msg.payload && Array.isArray(msg.payload.docs)) {\n    docs = msg.payload.docs;\n} else if (msg.payload && typeof msg.payload === 'object') {\n    docs = [msg.payload];\n}\n\ndocs = docs.filter(d => d && d._id && !String(d._id).startsWith('_design/'));\n\nmsg.payload = {\n    documentos: docs,\n    total: docs.length\n};\nreturn msg;",

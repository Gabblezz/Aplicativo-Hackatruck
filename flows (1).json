    {
        "id": "a4f50c79a03f1e93",
        "type": "function",
        "z": "02b62f923772707e",
        "name": "Filtrar avisos do usuario",
        "func": "const usuarioId = msg.req.params.usuarioId;\nlet docs = [];\n\nif (Array.isArray(msg.payload)) {\n    docs = msg.payload;\n} else if (msg.payload && Array.isArray(msg.payload.rows)) {\n    docs = msg.payload.rows.map(r => r.doc || r.value || r);\n} else if (msg.payload && Array.isArray(msg.payload.documentos)) {\n    docs = msg.payload.documentos;\n}\n\nconst usuario = docs.find(d => d.tipo === 'usuario' && d._id === usuarioId);\nif (!usuario) {\n    msg.statusCode = 404;\n    msg.payload = { erro: 'Usuario nao encontrado.' };\n    return msg;\n}\n\nconst prefs = usuario.notificacoes || { receberGeral: true, receberCursos: true };\nconst cursoUsuario = (usuario.curso || '').toLowerCase();\n\nfunction combinaDestino(item) {\n    const destino = item.destino || '';\n    const cursoDestino = (item.cursoDestino || '').toLowerCase();\n    if (destino === '@geral' && prefs.receberGeral) return true;\n    if (destino === '@curso' && cursoDestino === cursoUsuario && prefs.receberCursos) return true;\n    return false;\n}\n\nconst avisosPostagem = docs\n    .filter(d => d.tipo === 'postagem')\n    .filter(combinaDestino)\n    .map(p => ({\n        _id: p._id,\n        tipo: 'aviso',\n        usuarioId: usuarioId,\n        postagemId: p._id,\n        destino: p.destino,\n        titulo: p.destino === '@geral' ? 'Aviso geral' : 'Aviso do seu curso',\n        mensagem: p.text,\n        curso: p.cursoDestino || null,\n        criadaEm: p.timestamp || p.createdAt,\n        lida: false\n    }));\n\nconst avisosAnuncio = docs\n    .filter(d => d.tipo === 'anuncio')\n    .filter(combinaDestino)\n    .map(a => ({\n        _id: a._id,\n        tipo: 'aviso',\n        usuarioId: usuarioId,\n        postagemId: a._id,\n        destino: a.destino,\n        titulo: a.destino === '@geral' ? 'Novo anuncio geral' : 'Novo anuncio do seu curso',\n        mensagem: a.title + ': ' + a.description,\n        curso: a.cursoDestino || null,\n        criadaEm: a.createdAt,\n        lida: false\n    }));\n\nconst avisos = avisosPostagem\n    .concat(avisosAnuncio)\n    .sort((a, b) => (b.criadaEm || '').localeCompare(a.criadaEm || ''));\n\nmsg.statusCode = 200;\nmsg.payload = avisos;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

    {
        "id": "2e0ca939076ec0b5",
        "type": "function",
        "z": "02b62f923772707e",
        "name": "Filtrar usuario pelo _id",
        "func": "const usuarioId = msg.req.params.usuarioId;\nlet docs = [];\n\nif (Array.isArray(msg.payload)) {\n    docs = msg.payload;\n} else if (msg.payload && Array.isArray(msg.payload.rows)) {\n    docs = msg.payload.rows.map(r => r.doc || r.value || r);\n} else if (msg.payload && Array.isArray(msg.payload.documentos)) {\n    docs = msg.payload.documentos;\n}\n\nconst usuario = docs.find(d => d.tipo === 'usuario' && d._id === usuarioId);\n\nif (!usuario) {\n    msg.statusCode = 404;\n    msg.payload = { erro: 'Usuario nao encontrado.' };\n    return msg;\n}\n\nmsg.statusCode = 200;\nmsg.payload = usuario;\nreturn msg;",
